{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    { "name": "app", "installMode": "prefetch", "resources": { "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"] } },
    { "name": "assets", "installMode": "lazy", "updateMode": "prefetch", "resources": { "files": ["/**/*.(svg|png|ico|woff2)"] } }
  ],
  "dataGroups": [
    { "name": "api-estado", "urls": ["/api/salud", "/api/modelo"], "cacheConfig": { "strategy": "freshness", "maxSize": 5, "maxAge": "1h", "timeout": "3s" } }
  ]
}
